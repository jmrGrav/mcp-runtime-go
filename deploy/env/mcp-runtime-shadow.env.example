# Shadow deployment environment for the Go runtime.
# Copy to /etc/mcp-runtime-shadow/mcp-runtime-shadow.env and edit manually.

SHADOW_MODE=true
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8084
MCP_BACKEND_URL=<backend>
MCP_CA_CERT=<path>
MCP_PROXY_BASE_URL=<url_public>
MCP_ALLOWED_REDIRECT_URIS=<uris>
MCP_CLIENT_ID=<placeholder>
MCP_CLIENT_SECRET=<placeholder>
MCP_TOKEN_STORE=/var/lib/mcp-runtime-shadow/tokens.json
MCP_AUDIT_LOG=/var/log/mcp-runtime-shadow/audit.log
TRUSTED_PROXIES=127.0.0.1,::1
MANDATORY_PKCE=true
ALLOW_TOKEN_STORE_RECOVERY=false
LOG_LEVEL=info

# Current runtime keys are also accepted by the Go config loader.
# These aliases are left here for clarity during manual validation.
# GRAV_MCP_URL maps from MCP_BACKEND_URL
# PROXY_BASE_URL maps from MCP_PROXY_BASE_URL
# TOKENS_FILE maps from MCP_TOKEN_STORE
# AUDIT_LOG_FILE maps from MCP_AUDIT_LOG
