# Example OpenResty/Nginx mirror setup for shadow deployment.
#
# Python remains authoritative. The mirror sends a best-effort copy of the
# request to the Go shadow runtime. The mirror is fire-and-forget:
# - no guarantee of delivery
# - non-blocking for the client request
# - body mirroring may require `mirror_request_body on;`
# - keep the internal mirror location unreachable from the public edge

upstream go_shadow_runtime {
    server 127.0.0.1:8084;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name example.org;

    # Existing authoritative Python routing remains unchanged here.
    location / {
        proxy_pass http://python_authoritative_backend;

        # Mirror the request to the Go shadow runtime.
        mirror /__shadow_mirror;
        mirror_request_body on;
    }

    location = /__shadow_mirror {
        internal;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Client-Request-ID $http_x_request_id;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_pass http://go_shadow_runtime$request_uri;
    }
}
